# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

SECRET_KEY=change-this-to-a-random-string
DEBUG=True

# ---- Database ----
# Leave as "sqlite" to get running immediately with zero setup.
# Switch to "mysql" once you want to use your XAMPP/MySQL server.
DB_ENGINE=sqlite

DB_NAME=breadbasket_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Gemini API (AI forecasting) ----
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6KzmzvkktLumrcaub-KW45CZalE4R6X1BWjaUqtIKxc2w
# Check https://ai.google.dev/gemini-api/docs/models for the current model list —
# Google updates these fairly often. gemini-2.5-flash is a solid free-tier default as of writing.
GEMINI_MODEL=gemini-3.6-flash
